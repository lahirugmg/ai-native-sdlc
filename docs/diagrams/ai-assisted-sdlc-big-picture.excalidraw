      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3  \u00b7  Governance and security \u2014 a design input at every horizon and every pass of the loop, proportionate to impact",
      "originalText": "3  \u00b7  Governance and security \u2014 a design input at every horizon and every pass of the loop, proportionate to impact",
