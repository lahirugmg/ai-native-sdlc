      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Unit of change: individual and team habits.\n\u2022 Task framing: outcome, context, boundaries,\n   quality bar, verification\n\u2022 Bounded pilot \u2014 hypothesis, owner, stop\n   conditions, measured baseline\n\u2022 Every output reviewed; the person who ships\n   it stays accountable\nFails as: fluent output taken for correct output.",
      "originalText": "Unit of change: individual and team habits.\n\u2022 Task framing: outcome, context, boundaries,\n   quality bar, verification\n\u2022 Bounded pilot \u2014 hypothesis, owner, stop\n   conditions, measured baseline\n\u2022 Every output reviewed; the person who ships\n   it stays accountable\nFails as: fluent output taken for correct output.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 127
