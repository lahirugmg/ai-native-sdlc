    {
      "id": "text-ab66e456",
      "type": "text",
      "x": 1308,
      "y": 644.75,
      "width": 374.4,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
