      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Representative cases, shadow\nmode, and known failure modes\nprecede any widening of\nscope. Expansion is justified\nby measured value and support\ncapacity, not by\nnovelty.",
      "originalText": "Representative cases, shadow\nmode, and known failure modes\nprecede any widening of\nscope. Expansion is justified\nby measured value and support\ncapacity, not by\nnovelty.",
