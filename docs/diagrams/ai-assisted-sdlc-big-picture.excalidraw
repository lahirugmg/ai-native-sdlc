      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data boundaries",
      "originalText": "Data boundaries",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
