      "version": 1,
      "versionNonce": 511375310,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Run the acceptance test, not a vibe check\n\u2022 Review intent and risk, not only syntax\n\u2022 Record what failed and why \u2014 that is evidence\n\u2022 Feed the correction back into the context\n\u2022 Decide: accept, revise, or abandon\nLeaves behind: evidence, and context better than\nit was last pass.",
      "originalText": "\u2022 Run the acceptance test, not a vibe check\n\u2022 Review intent and risk, not only syntax\n\u2022 Record what failed and why \u2014 that is evidence\n\u2022 Feed the correction back into the context\n\u2022 Decide: accept, revise, or abandon\nLeaves behind: evidence, and context better than\nit was last pass.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 110
    },
