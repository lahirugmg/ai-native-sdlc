      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 12
    },
    {
      "id": "text-c628e01a",
      "type": "text",
      "x": 748,
      "y": 644.75,
      "width": 366.59999999999997,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-18b6f044"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 40769162,
      "version": 1,
      "versionNonce": 916967643,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Work only inside the agreed scope and access\n\u2022 One reversible change beats one large change\n\u2022 Keep the diff and the reasoning inspectable\n\u2022 Stop and re-plan when the ground moves\n\u2022 Speed never removes a step from the loop\nLeaves behind: a change that can be read in one\nsitting.",
      "originalText": "\u2022 Work only inside the agreed scope and access\n\u2022 One reversible change beats one large change\n\u2022 Keep the diff and the reasoning inspectable\n\u2022 Stop and re-plan when the ground moves\n\u2022 Speed never removes a step from the loop\nLeaves behind: a change that can be read in one\nsitting.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 110
    },
