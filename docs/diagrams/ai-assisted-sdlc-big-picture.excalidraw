      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Restate the goal and the acceptance test\n\u2022 Assemble the context the task actually needs\n\u2022 Name the blast radius and what must not change\n\u2022 Choose the smallest reversible slice\n\u2022 Make assumptions and uncertainty visible\nLeaves behind: a plan a reviewer could disagree\nwith.",
      "originalText": "\u2022 Restate the goal and the acceptance test\n\u2022 Assemble the context the task actually needs\n\u2022 Name the blast radius and what must not change\n\u2022 Choose the smallest reversible slice\n\u2022 Make assumptions and uncertainty visible\nLeaves behind: a plan a reviewer could disagree\nwith.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 110
