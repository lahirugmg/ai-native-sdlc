      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Approval and sign-off stay\nwith a named person at every\nhorizon. Autonomy may\nexpand; ownership of the\noutcome does not move to the\nmodel. Refusal and\nescalation are designed\npaths.",
      "originalText": "Approval and sign-off stay\nwith a named person at every\nhorizon. Autonomy may\nexpand; ownership of the\noutcome does not move to the\nmodel. Refusal and\nescalation are designed\npaths.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
